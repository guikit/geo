# ==============================================================================
# GenerateGeoAssets.cmake
# Generates a C++20 translation unit that registers embedded assets from
# ${ASSETS_DIR} into guikit::Assets via guikit::geo::RegisterEmbeddedAssets().
# ==============================================================================

if (NOT DEFINED ASSETS_DIR)
    message(FATAL_ERROR "GenerateGeoAssets.cmake: ASSETS_DIR is not defined")
endif()

if (NOT DEFINED OUTPUT_FILE)
    message(FATAL_ERROR "GenerateGeoAssets.cmake: OUTPUT_FILE is not defined")
endif()

get_filename_component(OUTPUT_DIR "${OUTPUT_FILE}" DIRECTORY)
file(MAKE_DIRECTORY "${OUTPUT_DIR}")

if (EXISTS "${ASSETS_DIR}")
    file(GLOB_RECURSE REL_ASSET_FILES RELATIVE "${ASSETS_DIR}" "${ASSETS_DIR}/*")
    list(SORT REL_ASSET_FILES)
else()
    set(REL_ASSET_FILES "")
endif()

set(CPP_OUT "// Auto-generated by cmake/GenerateGeoAssets.cmake. DO NOT EDIT.\n")
string(APPEND CPP_OUT "#include \"guikit/core/assets.hpp\"\n")
string(APPEND CPP_OUT "#include \"keel/core.h\"\n\n")
string(APPEND CPP_OUT "namespace guikit::geo {\n\n")
string(APPEND CPP_OUT "namespace {\n\n")

set(REG_CALLS "")
set(ASSET_IDX 0)

function(geo_hex_to_c_array HEX_STR OUT_VAR)
    string(LENGTH "${HEX_STR}" LEN)
    if (LEN LESS_EQUAL 4096)
        string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," BYTES "${HEX_STR}")
        set(${OUT_VAR} "    ${BYTES}\n" PARENT_SCOPE)
        return()
    endif()
    math(EXPR HALF "(${LEN} / 4) * 2")
    math(EXPR REST "${LEN} - ${HALF}")
    string(SUBSTRING "${HEX_STR}" 0 ${HALF} LEFT_HEX)
    string(SUBSTRING "${HEX_STR}" ${HALF} ${REST} RIGHT_HEX)
    geo_hex_to_c_array("${LEFT_HEX}" LEFT_OUT)
    geo_hex_to_c_array("${RIGHT_HEX}" RIGHT_OUT)
    set(${OUT_VAR} "${LEFT_OUT}${RIGHT_OUT}" PARENT_SCOPE)
endfunction()

foreach(REL_PATH IN LISTS REL_ASSET_FILES)
    set(FULL_PATH "${ASSETS_DIR}/${REL_PATH}")
    if (IS_DIRECTORY "${FULL_PATH}")
        continue()
    endif()

    string(REPLACE "\\" "/" NORM_REL "${REL_PATH}")
    set(VIRTUAL_PATH "assets/${NORM_REL}")

    get_filename_component(EXT "${NORM_REL}" LAST_EXT)
    string(TOLOWER "${EXT}" EXT_LOWER)
    string(REGEX REPLACE "^\\." "" MIME_TYPE "${EXT_LOWER}")

    file(SIZE "${FULL_PATH}" BYTE_SIZE)
    file(READ "${FULL_PATH}" HEX_CONTENT HEX)

    string(APPEND CPP_OUT "// ${VIRTUAL_PATH} (${BYTE_SIZE} bytes)\n")
    string(APPEND CPP_OUT "alignas(16) static constexpr keel::u8 kGeoAsset_${ASSET_IDX}[] = {\n")
    geo_hex_to_c_array("${HEX_CONTENT}" FORMATTED_HEX)
    string(APPEND CPP_OUT "${FORMATTED_HEX}")
    string(APPEND CPP_OUT "    0x00\n};\n\n")

    string(APPEND REG_CALLS "    guikit::Assets::Register(\"${VIRTUAL_PATH}\", kGeoAsset_${ASSET_IDX}, ${BYTE_SIZE}u, \"${MIME_TYPE}\");\n")
    math(EXPR ASSET_IDX "${ASSET_IDX} + 1")
endforeach()

string(APPEND CPP_OUT "} // namespace\n\n")
string(APPEND CPP_OUT "void RegisterEmbeddedAssets() noexcept {\n")
string(APPEND CPP_OUT "    static bool s_registered = false;\n")
string(APPEND CPP_OUT "    if (s_registered) return;\n")
string(APPEND CPP_OUT "    s_registered = true;\n")
string(APPEND CPP_OUT "${REG_CALLS}")
string(APPEND CPP_OUT "}\n\n")
string(APPEND CPP_OUT "} // namespace guikit::geo\n")

file(WRITE "${OUTPUT_FILE}.tmp" "${CPP_OUT}")
execute_process(
    COMMAND "${CMAKE_COMMAND}" -E copy_if_different "${OUTPUT_FILE}.tmp" "${OUTPUT_FILE}"
)
